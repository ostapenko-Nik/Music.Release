<Window x:Class="VKMusicController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayerForGame" Width="1000" Height="680" MinWidth="900" MinHeight="640"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Foreground="{DynamicResource UiTextBrush}" UseLayoutRounding="True">
    <Border x:Name="MainShell" Margin="8" CornerRadius="22" Background="{DynamicResource UiBackgroundBrush}"
            BorderBrush="{DynamicResource UiBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="218" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Background="{DynamicResource UiSidebarBrush}" CornerRadius="22,0,0,22" BorderBrush="{DynamicResource UiBorderBrush}" BorderThickness="0,0,1,0" Padding="22,28">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel>
                        <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource UiAccentBrush}" HorizontalAlignment="Left">
                            <TextBlock Text="♪" Foreground="{DynamicResource UiAccentTextBrush}" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="PlayerForGame" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,0" />
                        <TextBlock Text="Музыка рядом с игрой" Foreground="{DynamicResource UiMutedBrush}" FontSize="11" Margin="0,5,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="0,34,0,0">
                        <Button Style="{StaticResource UiButton}" Background="#353044" BorderBrush="#494054" HorizontalContentAlignment="Left" Padding="14,12" Content="♫    Плеер" Click="OnPlayerClicked" />
                        <Button Style="{StaticResource UiButton}" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left" Padding="14,12" Content="⚙    Настройки" Click="OnSettingsClicked" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Row="3">
                        <Border Height="1" Background="{DynamicResource UiBorderBrush}" Margin="0,0,0,20" />
                        <TextBlock Text="ПРИ ЗАПУСКЕ WINDOWS" Foreground="{DynamicResource UiMutedBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,0,0,12" />
                        <CheckBox x:Name="StartWithWindowsCheck" Style="{StaticResource UiCheckBox}" Content="Запускать в фоне"
                                  Checked="OnStartupChecked" Unchecked="OnStartupUnchecked" />
                        <TextBlock Text="Плеер работает в трее.&#10;Главное окно не открывается." FontSize="11" Foreground="{DynamicResource UiMutedBrush}" Margin="0,10,0,0" LineHeight="18" />
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="1" Margin="28,20,28,26">
                <Grid.RowDefinitions><RowDefinition Height="42" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <TextBlock Text="ВАШ МУЗЫКАЛЬНЫЙ ПУЛЬТ" Foreground="{DynamicResource UiMutedBrush}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource UiWindowButton}" Content="−" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="OnMinimizeClicked" />
                        <Button Style="{StaticResource UiWindowButton}" Content="×" ToolTip="Убрать в трей" AutomationProperties.Name="Убрать в трей" Click="OnCloseClicked" Margin="4,0,0,0" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,12,0,22">
                    <TextBlock Text="Музыка под рукой" FontSize="28" FontWeight="SemiBold" />
                    <TextBlock Text="Управляйте треками, оставаясь в игре." FontSize="13" Foreground="{DynamicResource UiMutedBrush}" Margin="0,7,0,0" />
                </StackPanel>
                <Border Grid.Row="2" Style="{StaticResource UiCard}" Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="144" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="144" Height="144">
                                <Border Background="#302C42" CornerRadius="16"><TextBlock Text="♫" Foreground="{DynamicResource UiAccentBrush}" FontSize="48" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                <Image x:Name="NowPlayingImage" Stretch="UniformToFill">
                                    <Image.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="144" Height="144" Background="White" CornerRadius="16" /></VisualBrush.Visual></VisualBrush></Image.OpacityMask>
                                </Image>
                                <Border BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="16" IsHitTestVisible="False" />
                            </Grid>
                            <Grid Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Center">
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="СЕЙЧАС В ПЛЕЕРЕ" Foreground="{DynamicResource UiAccentBrush}" FontSize="10" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" x:Name="NowPlayingTitle" Text="Пока нет трека" FontSize="27" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,9,0,0" />
                                <TextBlock Grid.Row="2" x:Name="NowPlayingArtist" Text="Откройте VK Музыку в браузере" Foreground="{DynamicResource UiMutedBrush}" FontSize="14" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
                                <TextBlock Grid.Row="3" x:Name="NowPlayingAlbum" Foreground="{DynamicResource UiMutedBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,14,0,0">
                                    <Ellipse x:Name="NowPlayingStatusDot" Width="6" Height="6" Fill="{DynamicResource UiMutedBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="NowPlayingStatus" Text="Ожидание музыки" Foreground="{DynamicResource UiMutedBrush}" FontSize="12" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                        <Grid Grid.Row="1" Margin="0,22,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button Style="{StaticResource UiButton}" Click="OnPreviousClicked" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal"><Path Data="M 0,0 L 2,0 L 2,12 L 0,12 Z M 12,0 L 3,6 L 12,12 Z" Fill="{DynamicResource UiTextBrush}" Width="12" Height="12" Stretch="Fill" Margin="0,0,8,0" /><TextBlock Text="Назад" /></StackPanel>
                            </Button>
                            <Button Grid.Column="1" x:Name="MainPlaybackButton" Style="{StaticResource UiPrimaryButton}" Click="OnPlayPauseClicked" Margin="0,0,8,0" Content="Воспроизвести" />
                            <Button Grid.Column="2" Style="{StaticResource UiButton}" Click="OnNextClicked">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="Вперёд" /><Path Data="M 0,0 L 9,6 L 0,12 Z M 10,0 L 12,0 L 12,12 L 10,12 Z" Fill="{DynamicResource UiTextBrush}" Width="12" Height="12" Stretch="Fill" Margin="8,0,0,0" /></StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource UiCard}" Margin="0,0,10,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Поверх игры" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Трек, перемотка и управление&#10;в компактном оверлее." Foreground="{DynamicResource UiMutedBrush}" FontSize="12" LineHeight="19" Margin="0,8,0,12" />
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button Style="{StaticResource UiButton}" Content="Показать" Click="OnShowOverlayClicked" Padding="8,10" Margin="0,0,6,0" />
                                <Button Grid.Column="1" Style="{StaticResource UiButton}" Content="Скрыть" Click="OnHideOverlayClicked" Padding="8,10" />
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource UiCard}" Margin="10,0,0,0" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Горячие клавиши" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,12" />
                            <ItemsControl x:Name="MainHotkeys">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" FontSize="12" Foreground="{DynamicResource UiMutedBrush}" VerticalAlignment="Center" />
                                        <Border Grid.Column="1" Background="{DynamicResource UiInputBrush}" CornerRadius="5" Padding="7,4"><TextBlock Text="{Binding Shortcut}" FontSize="10" /></Border>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>

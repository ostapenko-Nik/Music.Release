<Window x:Class="VKMusicController.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VKMusicController.Models"
        Title="Музыкальный плеер"
        Width="520" Height="190" MinWidth="520" MinHeight="190"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewMouseLeftButtonDown="OnWindowPreviewMouseLeftButtonDown"
        PreviewMouseLeftButtonUp="OnWindowPreviewMouseLeftButtonUp">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#A5A7B9" />
        <LinearGradientBrush x:Key="OverlayBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FF20212E" Offset="0" />
            <GradientStop Color="#FF171821" Offset="1" />
        </LinearGradientBrush>
        <Style x:Key="TransportButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#DADBE7" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="19"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#343544" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#DDD3FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.65" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlayPauseButton" TargetType="Button" BasedOn="{StaticResource TransportButton}">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#C6B6FA" />
            <Setter Property="Foreground" Value="#201B32" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" CornerRadius="19"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Path x:Name="PlaybackIcon" Width="12" Height="14" Stretch="Fill"
                                  Fill="{TemplateBinding Foreground}" Data="M 1,0 L 12,7 L 1,14 Z"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding PlaybackState}" Value="{x:Static models:PlaybackState.Playing}">
                                <Setter TargetName="PlaybackIcon" Property="Data" Value="M 0,0 L 4,0 L 4,14 L 0,14 Z M 8,0 L 12,0 L 12,14 L 8,14 Z" />
                                <Setter TargetName="PlaybackIcon" Property="Margin" Value="0" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#DED2FF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="White" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Background" Value="#AC98E5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ToolTip" Value="Воспроизвести" />
            <Setter Property="AutomationProperties.Name" Value="Воспроизвести" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding PlaybackState}" Value="{x:Static models:PlaybackState.Playing}">
                    <Setter Property="ToolTip" Value="Пауза" />
                    <Setter Property="AutomationProperties.Name" Value="Пауза" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="6">
        <Border x:Name="RootBorder" Background="{StaticResource OverlayBackgroundBrush}"
                CornerRadius="{Binding OverlayCornerRadius}" Padding="18"
                BorderBrush="#343542" BorderThickness="1" Opacity="0"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform ScaleX="0.92" ScaleY="0.92" />
            </Border.RenderTransform>
            <Border.Effect>
                <DropShadowEffect Color="#080910" BlurRadius="12" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="96" Height="96" Margin="0,0,18,0" VerticalAlignment="Center"
                          Visibility="{Binding ShowArtwork, Converter={StaticResource BoolToVisibilityConverter}}">
                        <Border Background="#2D2B40" CornerRadius="14">
                            <Path Data="M 16,3 L 16,22 C 16,27 7,29 6,24 C 5,20 11,17 14,19 L 14,6 L 28,3 L 28,19 C 28,24 19,26 18,21 C 17,17 23,14 26,16 L 26,0 Z"
                                  Width="30" Height="32" Stretch="Uniform" Fill="#B9A7EF"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Image Source="{Binding ArtworkImage}" Stretch="UniformToFill">
                            <Image.OpacityMask>
                                <VisualBrush>
                                    <VisualBrush.Visual>
                                        <Border Width="96" Height="96" CornerRadius="14" Background="White" />
                                    </VisualBrush.Visual>
                                </VisualBrush>
                            </Image.OpacityMask>
                        </Image>
                        <Border BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="14" IsHitTestVisible="False" />
                    </Grid>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="19" FontWeight="SemiBold"
                                   Foreground="#F5F4FA" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Row="1" Text="{Binding Artist}" ToolTip="{Binding Artist}" FontSize="13"
                                   Foreground="{StaticResource SecondaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"
                                   Visibility="{Binding ShowArtist, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <TextBlock Grid.Row="2" Text="{Binding Album}" ToolTip="{Binding Album}" FontSize="11"
                                   Foreground="#858799" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                   Visibility="{Binding ShowAlbum, Converter={StaticResource BoolToVisibilityConverter}}" />
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding ShowControls, Converter={StaticResource BoolToVisibilityConverter}}">
                                <Button Style="{StaticResource TransportButton}" Command="{Binding PreviousCommand}"
                                        ToolTip="Предыдущий трек" AutomationProperties.Name="Предыдущий трек" VerticalAlignment="Center">
                                    <Path Data="M 0,0 L 2,0 L 2,14 L 0,14 Z M 14,0 L 4,7 L 14,14 Z"
                                          Width="14" Height="14" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                                <Button x:Name="PlaybackButton" Style="{StaticResource PlayPauseButton}" Command="{Binding PlayPauseCommand}" Margin="6,0" />
                                <Button Style="{StaticResource TransportButton}" Command="{Binding NextCommand}"
                                        ToolTip="Следующий трек" AutomationProperties.Name="Следующий трек" VerticalAlignment="Center">
                                    <Path Data="M 0,0 L 10,7 L 0,14 Z M 12,0 L 14,0 L 14,14 L 12,14 Z"
                                          Width="14" Height="14" Stretch="Fill" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                </Button>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Ellipse Width="5" Height="5" Margin="0,0,6,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#858799" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PlaybackState}" Value="{x:Static models:PlaybackState.Playing}">
                                                    <Setter Property="Fill" Value="#C6B6FA" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{StaticResource SecondaryTextBrush}" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <Grid Grid.Row="1" Margin="0,6,0,0"
                      Visibility="{Binding ShowProgress, Converter={StaticResource BoolToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Slider x:Name="SeekSlider" Value="{Binding PositionSeconds, Mode=OneWay}"
                            Maximum="{Binding DurationSeconds}" Minimum="0" Height="16"
                            SmallChange="1" LargeChange="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" IsEnabled="{Binding CanSeek}" Cursor="Hand"
                            Foreground="#C6B6FA" Background="#353643" BorderThickness="0"
                            ToolTip="{Binding SeekHint}" ToolTipService.ShowOnDisabled="True"
                            AutomationProperties.Name="Позиция воспроизведения в секундах"
                            PreviewMouseLeftButtonDown="OnSeekMouseDown"
                            LostMouseCapture="OnSeekInteractionEnded"
                            LostKeyboardFocus="OnSeekInteractionEnded"
                            PreviewKeyDown="OnSeekKeyDown" PreviewKeyUp="OnSeekKeyUp"
                            ValueChanged="OnSeekValueChanged">
                        <Slider.Template>
                            <ControlTemplate TargetType="Slider">
                                <Grid Background="Transparent">
                                    <Border x:Name="TrackBackground" Height="4" CornerRadius="2"
                                            Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                                    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}"
                                           Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}"
                                           Orientation="Horizontal" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent">
                                                            <Border Height="4" CornerRadius="2" Background="#C6B6FA" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Width="10" Height="16">
                                                <Thumb.Template>
                                                    <ControlTemplate TargetType="Thumb">
                                                        <Grid Background="Transparent">
                                                            <Ellipse Width="10" Height="10" Fill="#DDD3FF" VerticalAlignment="Center" />
                                                        </Grid>
                                                    </ControlTemplate>
                                                </Thumb.Template>
                                            </Thumb>
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                                <RepeatButton.Template>
                                                    <ControlTemplate TargetType="RepeatButton">
                                                        <Border Background="Transparent" />
                                                    </ControlTemplate>
                                                </RepeatButton.Template>
                                            </RepeatButton>
                                        </Track.IncreaseRepeatButton>
                                    </Track>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="TrackBackground" Property="Background" Value="#555267" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Slider.Template>
                    </Slider>
                    <Grid Grid.Row="1">
                        <TextBlock Text="{Binding PositionText}" FontSize="10" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="#858799" HorizontalAlignment="Right" />
                    </Grid>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window x:Class="VKMusicController.Views.TrackNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PlayerForGame — новый трек" Width="400" Height="140"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        UseLayoutRounding="True" Foreground="{DynamicResource UiTextBrush}">
    <Border x:Name="NotificationCard" Margin="6" CornerRadius="20"
            Background="{DynamicResource UiBackgroundBrush}" BorderBrush="{DynamicResource UiBorderBrush}"
            BorderThickness="1" Padding="16" MouseLeftButtonUp="OnOpenPlayerClicked" Cursor="Hand"
            ToolTip="Открыть главное окно плеера">
        <Border.Effect><DropShadowEffect Color="#080910" BlurRadius="12" ShadowDepth="2" Opacity="0.35" /></Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="80" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Grid Width="80" Height="80" VerticalAlignment="Center">
                <Border Background="{DynamicResource UiSurfaceBrush}" CornerRadius="13">
                    <TextBlock Text="♫" Foreground="{DynamicResource UiAccentBrush}" FontSize="32" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Image x:Name="ArtworkImage" Stretch="UniformToFill">
                    <Image.OpacityMask><VisualBrush><VisualBrush.Visual><Border Width="80" Height="80" CornerRadius="13" Background="White" /></VisualBrush.Visual></VisualBrush></Image.OpacityMask>
                </Image>
                <Border BorderBrush="#18FFFFFF" BorderThickness="1" CornerRadius="13" IsHitTestVisible="False" />
            </Grid>
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="4" Height="12" Background="{DynamicResource UiAccentBrush}" CornerRadius="2" Margin="0,0,7,0" />
                        <TextBlock Text="НОВЫЙ ТРЕК" Foreground="{DynamicResource UiAccentBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <Button x:Name="DismissButton" Style="{StaticResource UiWindowButton}" Content="×" Width="22" Height="20" FontSize="14"
                            HorizontalAlignment="Right" VerticalAlignment="Center" Focusable="False" Click="OnDismissClicked"
                            ToolTip="Скрыть уведомление" AutomationProperties.Name="Скрыть уведомление" />
                </Grid>
                <TextBlock Grid.Row="1" x:Name="TrackTitle" Text="{Binding Title}" ToolTip="{Binding Title}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource UiTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                <TextBlock Grid.Row="2" x:Name="TrackArtist" Text="{Binding Artist}" ToolTip="{Binding Artist}" FontSize="12"
                           Foreground="{DynamicResource UiMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="Открыть плеер" FontSize="10" Foreground="{DynamicResource UiMutedBrush}" />
                    <Path Data="M 0,0 L 4,4 L 0,8" Stroke="{DynamicResource UiAccentBrush}" StrokeThickness="1.5"
                          Width="4" Height="8" Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
